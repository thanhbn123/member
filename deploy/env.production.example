# MEMBER service - production environment (TEMPLATE, no secrets).
#
#   install -m 600 deploy/env.production.example /srv/member/env/app.env
#   then fill in the values (openssl rand -hex 32 / python -m app.cli hash-password).
#
# Every variable the application reads is listed here; see README.md section 4 for the
# full reference and .env.example for the local development values.

# ------------------------------------------------------------------ application
APP_NAME=MEMBER
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://member.quangkhoiwellnessretreat.com   # must be https:// in production
API_DOCS_ENABLED=false

# ------------------------------------------------------------------ branding
BRAND_NAME=Quang Khoi Wellness Retreat
BRAND_TAGLINE=Chăm sóc sức khỏe chủ động – Phục hồi giấc ngủ – Trường thọ
BRAND_LOGO_URL=/static/img/qkwr-logo-horizontal.png
BRAND_FAVICON_URL=/static/img/qkwr-icon-32.png
BRAND_PRIMARY_COLOR=#00503e                         # Pine Teal (brand colour system)
BRAND_SUPPORT_EMAIL=booking@quangkhoi.org

# ------------------------------------------------------------------ contact details (landing footer)
BRAND_PHONE=0238.777.2222
BRAND_ADDRESS=Đường Trường Sa, phường Quỳnh Mai, Nghệ An
BRAND_FACEBOOK_URL=https://www.facebook.com/61583753080641
BRAND_ZALO_URL=

# ------------------------------------------------------------------ landing page (GET /)
LANDING_HERO_TITLE=Hành trình cân bằng Thân – Tâm – Trí
LANDING_HERO_SUBTITLE=Đăng ký thành viên QK Wellness & Retreat để nhận ưu đãi liệu trình, ưu tiên đặt phòng và cẩm nang chăm sóc sức khỏe chủ động.
LANDING_HERO_IMAGE_URL=
# Up to 6 items: "icon|title|description", separated by ";;" (see .env.example).
LANDING_BENEFITS=🌿|Ưu đãi liệu trình|Giảm giá các gói wellness, phục hồi giấc ngủ và chăm sóc sức khỏe chủ động;;🛏️|Ưu tiên đặt phòng|Đặt phòng sớm và nâng hạng khi còn trống;;📩|Cẩm nang sức khỏe|Nhận bài viết chuyên môn và lịch ưu đãi qua email
LANDING_CTA_TEXT=Nhận ưu đãi thành viên
LANDING_SHOW_FORM=true

# ------------------------------------------------------------------ database
DATABASE_URL=postgresql+psycopg://member:CHANGE_ME@member-db:5432/member
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------ security (generate, never reuse)
SECRET_KEY=CHANGE_ME_64_HEX
IP_HASH_SALT=CHANGE_ME_32_HEX
TRUSTED_PROXY_HEADERS=true                          # exactly ONE trusted proxy in front (Caddy/nginx)
SESSION_HTTPS_ONLY=true
SESSION_COOKIE_NAME=member_session
CSRF_ENABLED=true
SECURITY_HEADERS_ENABLED=true
MAX_REQUEST_BYTES=262144

# ------------------------------------------------------------------ admin UI
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH           # python -m app.cli hash-password
#   format: scrypt:<n>:<r>:<p>:<salt>:<digest>  (colon separated: a '$' inside a
#   .env value is eaten by Docker Compose interpolation and by shell `source`)

# ------------------------------------------------------------------ email
# EMAIL_MODE=smtp is mandatory in production (the app refuses to start otherwise).
EMAIL_MODE=smtp
VERIFICATION_TOKEN_TTL_HOURS=48
SMTP_HOST=smtp.gmail.com                            # member-mailpit = internal sink (no real delivery)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CHANGE_ME@gmail.com                        # must match SMTP_USER for Gmail
SMTP_FROM_NAME=VIPORDER Member
SMTP_TLS=true                                        # STARTTLS (port 587); port 465 uses implicit TLS
SMTP_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------ rate limiting
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW_SECONDS=3600
API_RATE_LIMIT=60
API_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# ------------------------------------------------------------------ public API (mandatory in production)
MEMBER_API_KEY=CHANGE_ME_48_HEX
CORS_ALLOW_ORIGINS=

# ------------------------------------------------------------------ meta conversions api (optional)
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_TEST_EVENT_CODE=
META_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------ verified-member webhook (optional)
MEMBER_VERIFIED_WEBHOOK_URL=
MEMBER_VERIFIED_WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_SECONDS=1.0

# ------------------------------------------------------------------ analytics (optional)
GA4_MEASUREMENT_ID=

# ------------------------------------------------------------------ CSP extras (optional)
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_STYLE_SRC=
CSP_EXTRA_IMG_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_FRAME_SRC=
