# =============================================================================
# MEMBER service - example environment file
#
# Copy to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored and must NEVER be committed with real values.
#
# Every value below is a harmless placeholder. Nothing here is a real secret,
# credential, token or customer name.
#
# Generating safe values:
#   SECRET_KEY:          python -c "import secrets; print(secrets.token_urlsafe(64))"
#   IP_HASH_SALT:        python -c "import secrets; print(secrets.token_urlsafe(32))"
#   ADMIN_PASSWORD_HASH: python -c "from app.security import hash_password; print(hash_password('your-strong-password'))"
#   WEBHOOK secret:      python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Tip: `ENV_FILE=/path/to/other.env` (read from the shell environment, not from
# this file) makes the app load a different env file. Default: `.env`.
# =============================================================================


# -----------------------------------------------------------------------------
# app
# -----------------------------------------------------------------------------
# Human readable service name (shown in logs / health endpoint).
APP_NAME=MEMBER
# Deployment environment: local | staging | production.
# `production` makes the app REFUSE TO START unless all of these hold: SECRET_KEY (non-placeholder,
# >= 32 chars), IP_HASH_SALT (non-placeholder, >= 16 chars), MEMBER_API_KEY (non-empty,
# non-placeholder, >= 16 chars), EMAIL_MODE=smtp with a non-empty SMTP_HOST, DATABASE_URL not
# SQLite, PUBLIC_BASE_URL non-empty and starting with https://, and a non-placeholder
# ADMIN_PASSWORD_HASH whenever ADMIN_EMAIL is also set.
APP_ENV=local
# Verbose error pages / extra logging. Never enable in production.
DEBUG=false
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
# Public origin used in verification links, canonical URLs and emails (no trailing slash).
# Production requires a non-empty value starting with https://.
PUBLIC_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# branding (customer specific - never hard-coded in the code)
# -----------------------------------------------------------------------------
# Brand shown in templates and emails.
BRAND_NAME=MEMBER
# Absolute URL of the brand logo (empty = text only).
BRAND_LOGO_URL=
# Primary brand color, hex: #rgb or #rrggbb.
BRAND_PRIMARY_COLOR=#2563eb
# Support address shown on pages/emails (empty = hidden).
BRAND_SUPPORT_EMAIL=support@example.com
# Short tagline under the logo (the env file is read as UTF-8).
BRAND_TAGLINE=Đăng ký thành viên


# -----------------------------------------------------------------------------
# database
# -----------------------------------------------------------------------------
# SQLite for local dev:  sqlite:///./member.db
# PostgreSQL for real deployments: postgresql+psycopg://user:password@localhost:5432/member
# Local development default (SQLite). For production use e.g.
# DATABASE_URL=postgresql+psycopg://member:CHANGE_ME@localhost:5432/member
DATABASE_URL=sqlite:///./member.db
# Log every SQL statement (development only).
DB_ECHO=false
# PostgreSQL connection pool sizing (ignored for SQLite).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# -----------------------------------------------------------------------------
# security
# -----------------------------------------------------------------------------
# Signs sessions/CSRF material. In production MUST be non-placeholder and >= 32 characters.
SECRET_KEY=change-me-to-a-long-random-value
# Salt for hashing visitor IPs. Raw IPs are never stored. In production MUST be non-placeholder
# and >= 16 characters.
IP_HASH_SALT=change-me-to-a-random-salt
# Trust the proxy headers ONLY under this exact contract: exactly ONE trusted reverse proxy in
# front, and that proxy APPENDS the peer address:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# The app then uses the RIGHTMOST X-Forwarded-For hop (the value the proxy appended) and ignores
# everything the client sent to its left; it falls back to X-Real-IP, then to the socket peer.
# NEVER enable this when clients can reach the app directly: they would control their own
# rate-limit bucket and ip_hash. In production leave it false unless you run such a proxy.
TRUSTED_PROXY_HEADERS=false
# Send security headers (CSP, X-Frame-Options, ...). Keep enabled.
SECURITY_HEADERS_ENABLED=true
# Reject request bodies larger than this many bytes (default 256 KiB). The check is preventive:
# the body is buffered and rejected with 413 before any handler runs - including chunked bodies
# with no Content-Length - and a rejected request has no side effects (nothing is persisted).
MAX_REQUEST_BYTES=262144
# Session cookie name / lifetime (seconds) / SameSite policy: lax | strict | none.
SESSION_COOKIE_NAME=member_session
SESSION_MAX_AGE_SECONDS=28800
# Leave unset for automatic behaviour: secure cookies in production or on https URLs.
# SESSION_HTTPS_ONLY=true
SESSION_SAME_SITE=lax
# Require a CSRF token on every HTML POST (recommended; API JSON endpoints are exempt).
CSRF_ENABLED=true
# Extra CSP sources (space or comma separated), merged into the default policy.
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_STYLE_SRC=
CSP_EXTRA_IMG_SRC=
CSP_EXTRA_CONNECT_SRC=
CSP_EXTRA_FRAME_SRC=


# -----------------------------------------------------------------------------
# admin
# -----------------------------------------------------------------------------
# Admin login email. Empty ADMIN_EMAIL or ADMIN_PASSWORD_HASH disables the admin UI.
ADMIN_EMAIL=admin@example.com
# scrypt hash produced by app.security.hash_password (never the plain password):
#   python -c "from app.security import hash_password; print(hash_password('your-strong-password'))"
# In production a placeholder hash refuses startup when ADMIN_EMAIL is also set; leaving either
# value empty disables the admin UI instead. The admin session uses SESSION_MAX_AGE_SECONDS.
ADMIN_PASSWORD_HASH=
#   format: scrypt:<n>:<r>:<p>:<salt>:<digest>  (colon separated: a '$' inside a
#   .env value is eaten by Docker Compose interpolation and by shell `source`)


# -----------------------------------------------------------------------------
# email (verification)
# -----------------------------------------------------------------------------
# How long a verification link stays valid, in hours.
VERIFICATION_TOKEN_TTL_HOURS=48
# console = print the email (including the RAW verification link) to stdout, dev/CI only.
# smtp = really send it. Production REQUIRES smtp: the app refuses to start with console.
EMAIL_MODE=console


# -----------------------------------------------------------------------------
# smtp (required when EMAIL_MODE=smtp)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope From address (must be SPF/DKIM authorised for the domain).
SMTP_FROM=
# Display name used in the From header.
SMTP_FROM_NAME=MEMBER
# STARTTLS. Keep true on port 587; use false only for a local relay on 25/1025.
SMTP_TLS=true
# Socket timeout in seconds.
SMTP_TIMEOUT_SECONDS=15


# -----------------------------------------------------------------------------
# rate limit (in-process, per worker - see docs/DEPLOYMENT.md)
# -----------------------------------------------------------------------------
# Registrations allowed per IP hash per window.
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW_SECONDS=3600
# Public API calls per key/IP per window.
API_RATE_LIMIT=60
API_RATE_WINDOW_SECONDS=60
# Admin login attempts per IP hash per window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900


# -----------------------------------------------------------------------------
# api
# -----------------------------------------------------------------------------
# Shared key for /api/v1/members*. MANDATORY in production (non-placeholder, >= 16 chars: the app
# refuses to start without it) because these endpoints expose member PII and can trigger
# verification emails. Empty is dev-only; /health and /api/v1/health are always open.
MEMBER_API_KEY=
# Set to false in production to hide /docs and /openapi.json
API_DOCS_ENABLED=true

# Comma separated browser origins allowed to call the API (empty = same-origin only).
CORS_ALLOW_ORIGINS=https://example.com,https://www.example.com


# -----------------------------------------------------------------------------
# meta (Conversions API - enabled only when pixel id AND access token are set)
# -----------------------------------------------------------------------------
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
# Test event code from Events Manager (leave empty in production).
META_TEST_EVENT_CODE=
META_TIMEOUT_SECONDS=10


# -----------------------------------------------------------------------------
# webhook (member.verified callback - enabled only when url AND secret are set)
# -----------------------------------------------------------------------------
MEMBER_VERIFIED_WEBHOOK_URL=
MEMBER_VERIFIED_WEBHOOK_SECRET=
# Per-attempt HTTP timeout. Worst case for GET /verify-email: 3 attempts x 5s + backoff (1s + 2s)
# + the Meta call (10s) ~= 28s, so set proxy_read_timeout >= 60s on the reverse proxy.
WEBHOOK_TIMEOUT_SECONDS=5
# Delivery attempts before giving up, and base delay for the exponential backoff.
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_SECONDS=1.0


# -----------------------------------------------------------------------------
# analytics
# -----------------------------------------------------------------------------
# GA4 measurement id, e.g. G-XXXXXXXXXX (empty = the tag is not rendered).
GA4_MEASUREMENT_ID=
